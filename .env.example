# Required outside mock mode. Uncomment and replace with real local values.
# NEXUS_SESSION_SECRET="generate-a-unique-random-secret-with-32-plus-characters"
# NEXUS_OAUTH_CLIENT_ID="client-id-issued-by-nexus"

# Private clients only: set both values and change NEXUS_OAUTH_CLIENT_TYPE to "private".
# Public PKCE clients must not send the client secret.
# NEXUS_OAUTH_CLIENT_TYPE="private"
# NEXUS_OAUTH_CLIENT_SECRET="client-secret-issued-by-nexus"

# Local OAuth URLs.
NEXUS_OAUTH_REDIRECT_URI="http://localhost:3000/api/auth/nexus/callback"
NEXUS_OAUTH_AUTH_URL="https://users.nexusmods.com/oauth/authorize"
NEXUS_OAUTH_TOKEN_URL="https://users.nexusmods.com/oauth/token"
NEXUS_ALLOWED_OAUTH_HOSTS="users.nexusmods.com"

NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXUS_API_BASE="https://api.nexusmods.com/v1"
NEXUS_API_V3_BASE="https://api.nexusmods.com/v3"
NEXUS_ALLOWED_API_HOSTS="api.nexusmods.com"
NEXUS_APPLICATION_NAME="Kairos List Manager"
NEXUS_APPLICATION_VERSION="0.1.0"

# Use sample data without a live OAuth session during UI development.
NEXUS_MOCK_MODE="true"
NEXUS_COLLECTION_SCHEMA_ID="1"
NEXUS_COLLECTION_CATEGORY_IDS="{\"Total Overhaul\":1,\"Themed\":2,\"Vanilla Plus\":3,\"Essentials\":4,\"Miscellaneous\":5}"

# Optional overrides: leave these variables undefined unless Nexus provides a value.
# NEXUS_COLLECTION_CATEGORY_ID="5"
# NEXUS_SEARCH_URL_TEMPLATE="https://api.nexusmods.com/..."
# NEXUS_COLLECTIONS_LIST_URL_TEMPLATE="https://api.nexusmods.com/..."
